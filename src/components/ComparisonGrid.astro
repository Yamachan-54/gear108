---
import AffiliateButton from './AffiliateButton.astro';
interface ProductRow {
  name: string;
  subtitle?: string;
  scores: Record<string, number>;
  comment?: string;
  href?: string;
}

interface Props {
  axes: string[];
  products: ProductRow[];
  max?: number;
}

const { axes, products, max = 5 } = Astro.props;
---
<section class="my-10 not-prose">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-8">
    {products.map((p) => (
      <article class="border-t-2 border-ink pt-4">
        <header class="mb-4">
          <h3 class="font-serif text-lg font-bold text-ink leading-tight">
            {p.href ? <a href={p.href} class="hover:text-akane">{p.name}</a> : p.name}
          </h3>
          {p.subtitle && <p class="text-xs text-ink-mute font-mono mt-1">{p.subtitle}</p>}
        </header>
        <ul class="space-y-2.5">
          {axes.map((axis) => {
            const score = Number(p.scores[axis] ?? 0);
            const pct = Math.max(0, Math.min(1, score / max)) * 100;
            return (
              <li>
                <div class="flex items-baseline justify-between text-xs mb-1">
                  <span class="text-ink-soft">{axis}</span>
                  <span class="font-mono text-ink">{score.toFixed(1)}</span>
                </div>
                <div class="h-px bg-rule overflow-hidden">
                  <div class="h-full bg-ink" style={`width: ${pct}%`} aria-hidden="true"></div>
                </div>
              </li>
            );
          })}
        </ul>
        {p.comment && (
          <p class="mt-4 text-xs text-ink-soft border-t border-rule pt-3 font-serif leading-relaxed">{p.comment}</p>
        )}
      </article>
    ))}
  </div>
</section>
