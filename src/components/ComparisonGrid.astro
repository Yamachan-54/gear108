---
// 製品比較を視覚的に提示するコンポーネント。
// 各製品ごとに名前 + スコア群（軸名→0..max） + 一行コメント を並べる。
interface ProductRow {
  name: string;
  subtitle?: string;
  scores: Record<string, number>;
  comment?: string;
  href?: string;
}

interface Props {
  axes: string[];           // 表示順を制御する軸名のリスト
  products: ProductRow[];
  max?: number;             // 各軸の最大値（既定 5）
}

const { axes, products, max = 5 } = Astro.props;
---
<section class="my-8 not-prose">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {products.map((p) => (
      <article class="border border-neutral-200 rounded-lg p-4 bg-white">
        <header class="mb-3">
          <h3 class="font-bold text-base text-neutral-900 leading-tight">
            {p.href ? <a href={p.href} class="hover:underline">{p.name}</a> : p.name}
          </h3>
          {p.subtitle && <p class="text-xs text-neutral-500 mt-0.5">{p.subtitle}</p>}
        </header>
        <ul class="space-y-2">
          {axes.map((axis) => {
            const score = Number(p.scores[axis] ?? 0);
            const pct = Math.max(0, Math.min(1, score / max)) * 100;
            return (
              <li>
                <div class="flex items-baseline justify-between text-xs">
                  <span class="text-neutral-700">{axis}</span>
                  <span class="font-mono text-neutral-600">{score.toFixed(1)}</span>
                </div>
                <div class="mt-1 h-1.5 rounded bg-neutral-100 overflow-hidden">
                  <div class="h-full bg-neutral-800" style={`width: ${pct}%`} aria-hidden="true"></div>
                </div>
              </li>
            );
          })}
        </ul>
        {p.comment && (
          <p class="mt-3 text-xs text-neutral-600 border-t border-neutral-100 pt-2">{p.comment}</p>
        )}
      </article>
    ))}
  </div>
</section>
