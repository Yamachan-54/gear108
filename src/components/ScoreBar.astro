---
interface Props {
  label: string;
  score: number;
  max?: number;
  note?: string;
}
const { label, score, max = 5, note } = Astro.props;
const pct = Math.max(0, Math.min(1, score / max)) * 100;
---
<div class="my-3 not-prose">
  <div class="flex items-baseline justify-between text-sm">
    <span class="font-serif font-medium text-ink">{label}</span>
    <span class="font-mono text-ink-soft">{score.toFixed(1)} / {max}</span>
  </div>
  <div class="mt-1.5 h-px bg-rule overflow-hidden">
    <div
      class="h-full bg-ink"
      style={`width: ${pct}%`}
      aria-hidden="true"
    ></div>
  </div>
  {note && <p class="mt-1.5 text-xs text-ink-mute font-serif">{note}</p>}
</div>
