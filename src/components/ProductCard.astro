---
interface Props {
  href: string;
  title: string;
  description?: string;
  image?: string;
  pubDate?: Date;
  category?: string;
  badge?: string;
}

const { href, title, description, image, pubDate, category, badge } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'numeric', day: 'numeric' });
---
<article class="border-b border-neutral-200 pb-6 last:border-0">
  <a href={href} class="no-underline group block">
    {image && (
      <div class="aspect-[16/9] overflow-hidden bg-neutral-100 rounded mb-3">
        <img
          src={image}
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    )}
    <div class="flex items-center gap-2 text-xs text-neutral-500 mb-1">
      {badge && <span>{badge}</span>}
      {category && (
        <>
          {badge && <span>・</span>}
          <span>{category}</span>
        </>
      )}
      {pubDate && (
        <>
          <span>・</span>
          <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        </>
      )}
    </div>
    <h3 class="font-bold text-lg leading-snug text-neutral-900 group-hover:text-blue-700 transition-colors">
      {title}
    </h3>
    {description && (
      <p class="mt-1 text-sm text-neutral-600 line-clamp-2">{description}</p>
    )}
  </a>
</article>
