---
import { CATEGORY_SHORT } from '../lib/category-theme';
import type { Category } from '../content.config';

type Variant = 'hero' | 'large' | 'medium' | 'small' | 'list';

interface Props {
  href: string;
  slug: string;
  title: string;
  description?: string;
  heroImage?: string;
  pubDate?: Date;
  category: Category;
  categoryLabel: string;
  badge?: string;
  variant?: Variant;
}

const {
  href,
  slug,
  title,
  description,
  heroImage,
  pubDate,
  category,
  categoryLabel,
  badge,
  variant = 'medium',
} = Astro.props;

const imgSrc = heroImage ?? `/og/${slug}.png`;
const catShort = CATEGORY_SHORT[category];

const fmt = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'numeric', day: 'numeric' });

const titleClass = {
  hero:   'text-2xl md:text-3xl font-serif font-bold leading-[1.35]',
  large:  'text-xl md:text-2xl font-serif font-bold leading-[1.35]',
  medium: 'text-base font-serif font-bold leading-snug',
  small:  'text-sm font-serif font-bold leading-snug',
  list:   'text-base font-serif font-bold leading-snug',
}[variant];
---
{variant === 'list' ? (
  <a href={href} class="group flex gap-4 py-4 border-b border-rule last:border-0">
    <div class="shrink-0 w-28 aspect-[16/9] overflow-hidden bg-paper-soft">
      <img src={imgSrc} alt="" loading="lazy" class="w-full h-full object-cover" />
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 text-[10px] mb-1 font-mono">
        {badge && <span class="font-bold tracking-widest uppercase text-akane">{badge}</span>}
        <span class="text-ink-mute">·</span>
        <span class="text-ink-mute tracking-wider uppercase">{catShort}</span>
        {pubDate && (
          <>
            <span class="text-ink-mute">·</span>
            <time datetime={pubDate.toISOString()} class="text-ink-mute">{fmt(pubDate)}</time>
          </>
        )}
      </div>
      <h3 class={`${titleClass} text-ink group-hover:text-akane transition-colors line-clamp-2`}>{title}</h3>
    </div>
  </a>
) : (
  <a href={href} class="group block">
    <div class="relative aspect-[16/9] overflow-hidden bg-paper-soft">
      <img
        src={imgSrc}
        alt=""
        loading={variant === 'hero' ? 'eager' : 'lazy'}
        class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-90"
      />
    </div>
    <div class="mt-3">
      <div class="flex items-center gap-2 text-[10px] mb-1.5 font-mono">
        {badge && <span class="font-bold tracking-widest uppercase text-akane">{badge}</span>}
        <span class="text-ink-mute">·</span>
        <span class="text-ink-mute tracking-wider uppercase">{catShort}</span>
      </div>
      <h3 class={`${titleClass} text-ink group-hover:text-akane transition-colors`}>
        {title}
      </h3>
      {variant !== 'small' && description && (
        <p class={`mt-2 ${variant === 'hero' || variant === 'large' ? 'text-base text-ink-soft line-clamp-3' : 'text-sm text-ink-soft line-clamp-2'} leading-relaxed`}>
          {description}
        </p>
      )}
      {pubDate && (
        <time datetime={pubDate.toISOString()} class="mt-2 block text-xs text-ink-mute font-mono">
          {fmt(pubDate)}
        </time>
      )}
    </div>
  </a>
)}
