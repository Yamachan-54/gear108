---
import AffiliateButton from './AffiliateButton.astro';

interface AffiliateLinks {
  amazon?: string;
  rakuten?: string;
  yodobashi?: string;
  biccamera?: string;
  official?: string;
}

interface Props {
  links: AffiliateLinks | undefined;
  productName?: string;
}

const { links, productName } = Astro.props;

const entries = links
  ? (Object.entries(links).filter(([, v]) => !!v) as [
      keyof AffiliateLinks,
      string,
    ][])
  : [];
---
{entries.length > 0 && (
  <section class="my-8 border border-neutral-200 rounded p-4 bg-neutral-50">
    <h3 class="text-sm font-bold text-neutral-800 mb-3">
      {productName ? `${productName} を購入する` : '購入リンク'}
    </h3>
    <div class="flex flex-wrap gap-2">
      {entries.map(([store, href]) => (
        <AffiliateButton href={href} store={store} />
      ))}
    </div>
    <p class="mt-3 text-xs text-neutral-500">
      ※ 価格は変動します。購入時に各サイトでご確認ください。
    </p>
  </section>
)}
