---
import AffiliateButton from './AffiliateButton.astro';

interface AffiliateLinks {
  amazon?: string;
  rakuten?: string;
  yodobashi?: string;
  biccamera?: string;
  official?: string;
}

interface Props {
  links: AffiliateLinks | undefined;
  productName?: string;
}

const { links, productName } = Astro.props;

const entries = links
  ? (Object.entries(links).filter(([, v]) => !!v) as [
      keyof AffiliateLinks,
      string,
    ][])
  : [];
---
{entries.length > 0 && (
  <section class="my-10 border-t-2 border-ink pt-5 not-prose">
    <p class="eyebrow text-akane mb-3">PURCHASE</p>
    <h3 class="font-serif text-lg font-bold text-ink mb-4">
      {productName ? `${productName} を購入する` : '購入リンク'}
    </h3>
    <div class="flex flex-wrap gap-2">
      {entries.map(([store, href]) => (
        <AffiliateButton href={href} store={store} />
      ))}
    </div>
    <p class="mt-4 text-xs text-ink-mute font-mono">
      ※ 価格は変動します。購入時に各サイトでご確認ください。
    </p>
  </section>
)}
