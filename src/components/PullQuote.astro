---
interface Props {
  attribution?: string;
}
const { attribution } = Astro.props;
---
<figure class="my-12 border-t border-akane border-b border-rule py-8">
  <blockquote class="font-serif text-xl md:text-2xl font-bold leading-[1.55] text-ink tracking-tight">
    <slot />
  </blockquote>
  {attribution && (
    <figcaption class="mt-4 eyebrow text-ink-mute">
      — {attribution}
    </figcaption>
  )}
</figure>
