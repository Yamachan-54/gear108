---
// Margin の戒律「色は1色のみ」に従い、3 variant とも朱赤のみで差別化。
// 違いは枠の太さ・配置・ラベル文字で出す。
type Variant = 'note' | 'warn' | 'tip';

interface Props {
  variant?: Variant;
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const VARIANT: Record<Variant, { label: string; styleClass: string }> = {
  note: { label: 'NOTE',  styleClass: 'border-l border-rule pl-4' },
  warn: { label: '注意',  styleClass: 'border-l-[3px] border-akane pl-4' },
  tip:  { label: 'TIP',   styleClass: 'border-l-[3px] border-akane pl-4 bg-paper-soft py-3 -ml-4 px-4' },
};

const v = VARIANT[variant];
---
<aside class={`my-7 ${v.styleClass}`}>
  <div class="flex items-baseline gap-2 mb-1">
    <span class="eyebrow text-akane">{v.label}</span>
    {title && <span class="font-serif font-bold text-ink">{title}</span>}
  </div>
  <div class="text-sm md:text-base text-ink-soft leading-relaxed">
    <slot />
  </div>
</aside>
