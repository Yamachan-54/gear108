---
type Store = 'amazon' | 'rakuten' | 'yodobashi' | 'biccamera' | 'official';

interface Props {
  href: string;
  store: Store;
  label?: string;
}

const { href, store, label } = Astro.props;

const STORE_NAMES: Record<Store, string> = {
  amazon: 'Amazon',
  rakuten: '楽天市場',
  yodobashi: 'ヨドバシ',
  biccamera: 'ビックカメラ',
  official: '公式サイト',
};

const meta = STORE_NAMES[store];
---
<a
  href={href}
  rel="sponsored noopener"
  target="_blank"
  data-affiliate-store={store}
  data-affiliate-href={href}
  class="inline-flex items-center gap-2 px-4 py-2 border border-ink text-ink text-sm no-underline hover:bg-ink hover:text-paper transition-colors font-mono"
>
  <span>{label ?? `${meta}`}</span>
  <span aria-hidden="true">→</span>
</a>
