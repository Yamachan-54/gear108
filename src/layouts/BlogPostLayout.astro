---
import BaseLayout from './BaseLayout.astro';
import AuthorSignature from '../components/AuthorSignature.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../content.config';
import type { Category, CollectionName } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  slug: string;
  category: Category;
  tags?: string[];
  collection: CollectionName;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  slug,
  category,
  tags = [],
  collection,
} = Astro.props;

const autoOg = `/og/${slug}.png`;
const heroSrc = heroImage ?? autoOg;
const heroWebp = heroImage ? null : `/og/${slug}.webp`;  // 自動生成OGのWebP版（軽量配信）
const ogImageForMeta = heroImage ?? autoOg;

const fmt = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description} ogImage={ogImageForMeta}>
  {/* 雑誌のグリッド：左に小さなメタ柱、右に大きな本文柱（1:3の非対称）
      モバイルでは title→body→aside（meta は記事末に） */}
  <article class="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-8 md:gap-12">
    {/* 左の柱：メタ情報・パンくず・タグ — モバイルでは末尾に回す */}
    <aside class="order-2 md:order-1 md:sticky md:top-32 md:self-start md:max-h-[80vh] md:overflow-y-auto pr-2 border-t md:border-t-0 border-rule pt-6 md:pt-0">
      <nav class="text-xs font-mono text-ink-mute mb-4 flex flex-wrap gap-x-2 gap-y-1">
        <a href="/" class="hover:text-akane">HOME</a>
        <span>/</span>
        <a href={`/${collection}/`} class="hover:text-akane uppercase">{COLLECTION_LABELS[collection]}</a>
        <span>/</span>
        <a href={`/categories/${category}/`} class="hover:text-akane uppercase">{category}</a>
      </nav>

      <p class="eyebrow text-akane">{COLLECTION_LABELS[collection]}</p>
      <p class="mt-1 text-sm font-serif font-bold text-ink-soft">{CATEGORY_LABELS[category]}</p>

      <dl class="mt-6 space-y-3 text-xs">
        <div>
          <dt class="eyebrow text-ink-mute">PUBLISHED</dt>
          <dd class="mt-0.5 font-mono text-ink"><time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time></dd>
        </div>
        {updatedDate && (
          <div>
            <dt class="eyebrow text-ink-mute">UPDATED</dt>
            <dd class="mt-0.5 font-mono text-ink"><time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></dd>
          </div>
        )}
        {tags.length > 0 && (
          <div>
            <dt class="eyebrow text-ink-mute">TAGS</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5 font-mono text-ink-soft">
              {tags.map((t) => <span class="text-[11px]">#{t}</span>)}
            </dd>
          </div>
        )}
      </dl>
    </aside>

    {/* 右の柱：見出し・本文 — モバイルでは先頭に来る */}
    <div class="order-1 md:order-2 min-w-0">
      <header class="mb-8 pb-6 border-b border-rule">
        <h1 class="text-3xl md:text-[2.6rem] font-serif font-bold leading-[1.3] tracking-tight text-ink">{title}</h1>
        <p class="mt-4 text-base md:text-lg text-ink-soft leading-relaxed font-serif">{description}</p>
      </header>

      <picture>
        {heroWebp && <source srcset={heroWebp} type="image/webp" />}
        <img
          src={heroSrc}
          alt=""
          class="w-full aspect-[1200/630] object-cover mb-10 border border-rule"
          loading="lazy"
          decoding="async"
          width="1200"
          height="630"
        />
      </picture>

      <div class="prose-article">
        <slot />
      </div>

      <AuthorSignature />

      <p class="mt-10 text-xs text-ink-mute font-mono">
        ※ 本記事には、Amazonアソシエイト・楽天アフィリエイト等のリンクを含みます。
        購入時の価格・仕様は各販売ページでご確認ください。
      </p>
    </div>
  </article>
</BaseLayout>
