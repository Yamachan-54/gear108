---
import BaseLayout from './BaseLayout.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../content.config';
import type { Category, CollectionName } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category: Category;
  tags?: string[];
  collection: CollectionName;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  tags = [],
  collection,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description} ogImage={heroImage}>
  <article>
    <nav class="text-xs text-neutral-500 mb-4">
      <a href="/" class="hover:underline">ホーム</a>
      <span class="mx-1">›</span>
      <a href={`/${collection}/`} class="hover:underline">{COLLECTION_LABELS[collection]}</a>
      <span class="mx-1">›</span>
      <a href={`/categories/${category}/`} class="hover:underline">{CATEGORY_LABELS[category]}</a>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-900">{title}</h1>
      <p class="mt-3 text-neutral-700">{description}</p>
      <div class="mt-3 text-xs text-neutral-500 flex flex-wrap gap-3">
        <time datetime={pubDate.toISOString()}>公開: {fmt(pubDate)}</time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>更新: {fmt(updatedDate)}</time>
        )}
        <span>{CATEGORY_LABELS[category]}</span>
      </div>
      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2 text-xs text-neutral-500">
          {tags.map((t) => (
            <span>#{t}</span>
          ))}
        </div>
      )}
    </header>

    {heroImage && (
      <img
        src={heroImage}
        alt=""
        class="w-full max-h-[420px] object-cover rounded mb-8"
        loading="eager"
      />
    )}

    <div class="prose-article">
      <slot />
    </div>

    <hr class="my-10 border-neutral-200" />
    <p class="text-xs text-neutral-500">
      ※ 本記事には、Amazonアソシエイト・楽天アフィリエイト等のリンクを含みます。
      購入時の価格・仕様は各販売ページでご確認ください。
    </p>
  </article>
</BaseLayout>
