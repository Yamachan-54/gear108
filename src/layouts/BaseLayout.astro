---
import '../styles/global.css';
import { COLLECTION_LABELS, CATEGORY_LABELS } from '../content.config';
import type { Category } from '../content.config';
import { CATEGORY_COLOR } from '../lib/category-theme';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'エンジニア向け最新ガジェットのレビュー・比較・ニュース・選び方ガイドを毎日届ける情報サイト',
  ogImage = '/og/default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const collectionNav = Object.entries(COLLECTION_LABELS) as [string, string][];
const categoryNav = Object.entries(CATEGORY_LABELS) as [Category, string][];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="gear108" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title} | gear108</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900">
    {/* ヘッダー：上部にロゴ+コレクションタブ、下にカテゴリ色帯 */}
    <header class="border-b border-neutral-200 sticky top-0 bg-white/95 backdrop-blur z-20">
      {/* 上段：ロゴ + コレクションタブ */}
      <div class="border-b border-neutral-100">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
          <a href="/" class="font-black text-2xl tracking-tight text-neutral-900 hover:text-pink-600 transition-colors">
            gear<span class="text-pink-500">108</span>
          </a>
          <nav class="hidden md:flex flex-wrap gap-x-5 gap-y-1 text-sm text-neutral-700 font-medium">
            {collectionNav.map(([slug, label]) => (
              <a href={`/${slug}/`} class="hover:text-pink-600 transition-colors">{label}</a>
            ))}
          </nav>
        </div>
      </div>
      {/* 下段：カテゴリ色帯 */}
      <div class="overflow-x-auto">
        <div class="max-w-6xl mx-auto px-4 py-2 flex items-center gap-1 text-[11px] font-mono font-bold tracking-wider whitespace-nowrap">
          <span class="text-neutral-400 mr-2">CATEGORIES</span>
          {categoryNav.map(([slug, label]) => {
            const c = CATEGORY_COLOR[slug];
            return (
              <a
                href={`/categories/${slug}/`}
                class="px-2 py-1 rounded hover:bg-neutral-100 transition-colors flex items-center gap-1.5"
              >
                <span class="inline-block w-2 h-2 rounded-full" style={`background-color:${c.hex}`}></span>
                <span class="text-neutral-700">{label}</span>
              </a>
            );
          })}
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 mt-12 py-8 text-sm text-neutral-500">
      <div class="max-w-6xl mx-auto px-4">
        <p class="font-bold text-neutral-700">
          gear<span class="text-pink-500">108</span> — エンジニア向け最新ガジェット情報サイト
        </p>
        <p class="mt-2 text-xs">
          ※ 本サイトには Amazonアソシエイト・楽天アフィリエイト等のリンクが含まれます。
        </p>
        <p class="mt-2 text-xs">
          © {new Date().getFullYear()} gear108
        </p>
      </div>
    </footer>
  </body>
</html>
