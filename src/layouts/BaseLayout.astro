---
import '../styles/global.css';
import { COLLECTION_LABELS, CATEGORY_LABELS } from '../content.config';
import type { Category } from '../content.config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'エンジニア向け最新ガジェットのレビュー・比較・ニュース・選び方ガイドを毎日届ける情報サイト',
  ogImage = '/og/default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const collectionNav = Object.entries(COLLECTION_LABELS) as [string, string][];
const categoryNav = Object.entries(CATEGORY_LABELS) as [Category, string][];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />

    {/* Margin の戒律：三位一体タイポ */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&family=Inter:wght@400;500;700&family=Fira+Code:wght@400;500;700&display=swap" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="gear108" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title} | gear108</title>
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    {/* ヘッダー：上段マスト + 下段カテゴリラベル列 */}
    <header class="border-b border-rule sticky top-0 bg-paper/95 backdrop-blur z-20">
      <div class="border-b border-rule">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <a href="/" class="text-2xl font-serif font-bold tracking-tight text-ink hover:text-akane transition-colors">
            gear<span style={`color:${'#c1272d'}`}>108</span>
          </a>
          <nav class="flex flex-wrap items-baseline gap-x-4 md:gap-x-6 gap-y-1 text-xs md:text-sm w-full md:w-auto md:order-none">
            {collectionNav.map(([slug, label]) => (
              <a href={`/${slug}/`} class="text-ink-soft hover:text-akane transition-colors">{label}</a>
            ))}
            <a href="/about/" class="text-ink-soft hover:text-akane transition-colors">運営</a>
          </nav>
        </div>
      </div>
      {/* カテゴリ：英字短縮、横スクロール、墨色の上に朱赤の点 */}
      <div class="overflow-x-auto">
        <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center gap-1 whitespace-nowrap">
          <span class="eyebrow text-ink-mute mr-3 shrink-0">CATEGORIES</span>
          {categoryNav.map(([slug, label]) => (
            <a
              href={`/categories/${slug}/`}
              class="font-mono text-[11px] font-bold tracking-wider uppercase px-2 py-1 text-ink-soft hover:text-akane transition-colors flex items-center gap-1.5"
            >
              <span class="text-ink-mute">{label}</span>
            </a>
          ))}
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto w-full px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-rule mt-16 py-10 text-sm text-ink-soft">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <p class="font-serif font-bold text-ink text-lg">
            gear<span style={`color:${'#c1272d'}`}>108</span>
          </p>
          <p class="mt-1 text-xs text-ink-mute">エンジニア向け最新ガジェット情報サイト</p>
        </div>
        <div class="text-xs">
          <p class="eyebrow text-ink-mute mb-2">セクション</p>
          <ul class="space-y-1">
            {collectionNav.map(([slug, label]) => (
              <li><a href={`/${slug}/`} class="text-ink-soft hover:text-akane">{label}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-xs">
          <p class="eyebrow text-ink-mute mb-2">運営</p>
          <ul class="space-y-1">
            <li><a href="/about/" class="text-ink-soft hover:text-akane">運営者について</a></li>
          </ul>
          <p class="mt-4 text-ink-mute leading-relaxed">
            ※ 本サイトには Amazonアソシエイト・楽天アフィリエイト等のリンクが含まれます。
          </p>
          <p class="mt-2 text-ink-mute">© {new Date().getFullYear()} gear108</p>
        </div>
      </div>
    </footer>
  </body>
</html>
