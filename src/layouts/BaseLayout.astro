---
import '../styles/global.css';
import { COLLECTION_LABELS } from '../content.config';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'エンジニア向け最新ガジェットのレビュー・比較・ニュース・選び方ガイドを毎日届ける情報サイト',
  ogImage = '/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const collectionNav = Object.entries(COLLECTION_LABELS) as [string, string][];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="gear108" href="/rss.xml" />
    <meta name="description" content={description} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="gear108" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <title>{title} | gear108</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900">
    <header class="border-b border-neutral-200">
      <div class="max-w-3xl mx-auto px-4 py-5 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2">
        <a href="/" class="font-bold text-2xl tracking-tight no-underline text-neutral-900 hover:text-neutral-600">
          gear108
        </a>
        <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-neutral-700">
          {collectionNav.map(([slug, label]) => (
            <a
              href={`/${slug}/`}
              class="no-underline hover:underline hover:text-neutral-900"
            >{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-3xl mx-auto w-full px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 mt-12 py-8 text-sm text-neutral-500">
      <div class="max-w-3xl mx-auto px-4">
        <p>gear108 — エンジニア向け最新ガジェット情報サイト</p>
        <p class="mt-2 text-xs">
          ※ 本サイトには Amazonアソシエイト・楽天アフィリエイト等のリンクが含まれます。
        </p>
        <p class="mt-2 text-xs">
          © {new Date().getFullYear()} gear108
        </p>
      </div>
    </footer>
  </body>
</html>
