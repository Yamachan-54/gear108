---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../content.config';

type Item = {
  collection: keyof typeof COLLECTION_LABELS;
  slug: string;
  data: any;
};

async function fetchAll(): Promise<Item[]> {
  const types = Object.keys(COLLECTION_LABELS) as Item['collection'][];
  const buckets = await Promise.all(
    types.map((c) => getCollection(c, ({ data }) => !data.draft)),
  );
  return buckets.flatMap((entries, i) =>
    entries.map((e) => ({
      collection: types[i]!,
      slug: e.id,
      data: e.data,
    })),
  );
}

const all = (await fetchAll()).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);

const latest = all.slice(0, 12);
const categoryEntries = Object.entries(CATEGORY_LABELS) as [string, string][];
---
<BaseLayout
  title="エンジニア向け最新ガジェット"
  description="エンジニア向けの最新ガジェット・周辺機器のレビュー・比較・ニュース・選び方ガイドを届けます。"
>
  <section class="mb-10">
    <h1 class="sr-only">gear108</h1>
    <p class="text-neutral-700 leading-relaxed">
      キーボード、モニター、PC、デスク——働く道具を一つずつ検証します。
      レビュー・比較・選び方を中心に、エンジニアの机の上で本当に使えるガジェットを紹介します。
    </p>
  </section>

  <section class="mb-10">
    <h2 class="text-base font-bold text-neutral-900 mb-3">カテゴリ</h2>
    <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {categoryEntries.map(([slug, label]) => (
        <li>
          <a href={`/categories/${slug}/`} class="text-neutral-700 hover:underline">{label}</a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="text-base font-bold text-neutral-900 mb-4">最新の記事</h2>
    {latest.length === 0 ? (
      <p class="text-neutral-500 text-sm">まだ記事がありません。</p>
    ) : (
      <div class="space-y-6">
        {latest.map((item) => (
          <ProductCard
            href={`/${item.collection}/${item.slug}/`}
            title={item.data.title}
            description={item.data.description}
            image={item.data.heroImage}
            pubDate={new Date(item.data.pubDate)}
            category={CATEGORY_LABELS[item.data.category as keyof typeof CATEGORY_LABELS]}
            badge={COLLECTION_LABELS[item.collection]}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
