---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../content.config';
import type { Category, CollectionName } from '../content.config';
import { CATEGORY_SHORT } from '../lib/category-theme';

type Item = {
  collection: CollectionName;
  slug: string;
  data: any;
};

const collTypes = Object.keys(COLLECTION_LABELS) as CollectionName[];
const buckets = await Promise.all(
  collTypes.map((c) => getCollection(c, ({ data }) => !data.draft)),
);
const all: Item[] = buckets.flatMap((entries, i) =>
  entries.map((e) => ({
    collection: collTypes[i]!,
    slug: e.id,
    data: e.data,
  })),
);
all.sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const [hero, ...rest] = all;
const featured = rest.slice(0, 4);
const remaining = rest.slice(4);

const byCategory = new Map<Category, Item[]>();
for (const it of all) {
  const cat = it.data.category as Category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(it);
}
const categoryEntries = Object.entries(CATEGORY_LABELS) as [Category, string][];

const ranking = all
  .filter((i) => i.collection === 'reviews' && typeof i.data.rating === 'number')
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
  .slice(0, 5);
---
<BaseLayout
  title="エンジニア向け最新ガジェット"
  description="エンジニア向け最新ガジェットのレビュー・比較・ニュース・選び方ガイドを毎日届けます。"
>
  {/* ====== HERO + RANKING（非対称 5:3） ====== */}
  {hero && (
    <section class="grid grid-cols-1 lg:grid-cols-[5fr_3fr] gap-x-10 gap-y-8 mb-16 pb-16 border-b border-rule">
      <div>
        <p class="eyebrow text-akane mb-2">FEATURED · {COLLECTION_LABELS[hero.collection].toUpperCase()}</p>
        <ArticleCard
          href={`/${hero.collection}/${hero.slug}/`}
          slug={hero.slug}
          title={hero.data.title}
          description={hero.data.description}
          heroImage={hero.data.heroImage}
          pubDate={new Date(hero.data.pubDate)}
          category={hero.data.category}
          categoryLabel={CATEGORY_LABELS[hero.data.category as Category]}
          badge={COLLECTION_LABELS[hero.collection]}
          variant="hero"
        />
      </div>

      <aside class="lg:pt-10">
        <p class="eyebrow text-akane mb-4">TOP RATED</p>
        {ranking.length === 0 ? (
          <p class="text-sm text-ink-mute font-serif">まだランキングが作れる量じゃない。</p>
        ) : (
          <ol class="space-y-5">
            {ranking.map((item, i) => (
              <li class="grid grid-cols-[auto_1fr] gap-4 items-baseline">
                <span class="font-serif font-bold text-3xl text-ink-mute leading-none w-10 shrink-0 text-right">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <a href={`/${item.collection}/${item.slug}/`} class="group min-w-0">
                  <div class="flex items-center gap-2 text-[10px] mb-1 font-mono">
                    <span class="text-akane font-bold tracking-widest uppercase">{COLLECTION_LABELS[item.collection]}</span>
                    <span class="text-ink-mute">·</span>
                    <span class="text-ink-soft">★ {item.data.rating.toFixed(1)}</span>
                  </div>
                  <h3 class="font-serif text-base font-bold leading-snug text-ink group-hover:text-akane line-clamp-2">
                    {item.data.title}
                  </h3>
                </a>
              </li>
            ))}
          </ol>
        )}
      </aside>
    </section>
  )}

  {/* ====== FEATURED 4列（タイトル左寄せ、目次風） ====== */}
  {featured.length > 0 && (
    <section class="mb-16 pb-16 border-b border-rule">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="section-title">FEATURED</h2>
        <p class="text-xs font-mono text-ink-mute uppercase tracking-widest">直近の {featured.length} 本</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        {featured.map((item) => (
          <ArticleCard
            href={`/${item.collection}/${item.slug}/`}
            slug={item.slug}
            title={item.data.title}
            description={item.data.description}
            heroImage={item.data.heroImage}
            pubDate={new Date(item.data.pubDate)}
            category={item.data.category}
            categoryLabel={CATEGORY_LABELS[item.data.category as Category]}
            badge={COLLECTION_LABELS[item.collection]}
            variant="medium"
          />
        ))}
      </div>
    </section>
  )}

  {/* ====== カテゴリ：版面の章立て風（左タイポ柱） ====== */}
  <section class="mb-16 pb-16 border-b border-rule grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-x-10 gap-y-6">
    <div>
      <h2 class="section-title">CATEGORIES</h2>
      <p class="text-sm text-ink-soft font-serif leading-relaxed">
        机の上にあるすべての道具を、8つの章に分けた。
      </p>
    </div>
    <div class="divide-y divide-rule">
      {categoryEntries.map(([slug, label]) => {
        const count = byCategory.get(slug)?.length ?? 0;
        return (
          <a
            href={`/categories/${slug}/`}
            class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-4 py-4 hover:bg-paper-soft transition-colors px-2 -mx-2"
          >
            <span class="eyebrow text-ink-mute group-hover:text-akane">{CATEGORY_SHORT[slug]}</span>
            <span class="font-serif text-lg font-bold text-ink group-hover:text-akane">
              {label}
            </span>
            <span class="font-mono text-xs text-ink-mute">
              {count} {count === 1 ? 'piece' : 'pieces'}
            </span>
          </a>
        );
      })}
    </div>
  </section>

  {/* ====== MORE：縦リスト（雑誌の目次） ====== */}
  {remaining.length > 0 && (
    <section class="mb-16">
      <h2 class="section-title">ARCHIVE</h2>
      <div>
        {remaining.map((item) => (
          <ArticleCard
            href={`/${item.collection}/${item.slug}/`}
            slug={item.slug}
            title={item.data.title}
            heroImage={item.data.heroImage}
            pubDate={new Date(item.data.pubDate)}
            category={item.data.category}
            categoryLabel={CATEGORY_LABELS[item.data.category as Category]}
            badge={COLLECTION_LABELS[item.collection]}
            variant="list"
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
