---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../../content.config';
import type { Category } from '../../content.config';

const items = (await getCollection('reviews', ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);
---
<BaseLayout title="レビュー一覧" description="エンジニア向けガジェットの実機レビュー">
  <header class="mb-10 grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-6 pb-6 border-b border-rule">
    <div>
      <p class="eyebrow text-akane">REVIEW</p>
      <h1 class="font-serif text-3xl font-bold mt-1">レビュー</h1>
    </div>
    <p class="font-serif text-ink-soft leading-relaxed pt-1">
      長期使用を前提とした実機レビュー。「ここまでは確認済み、ここからは未検証」を毎回明示します。
    </p>
  </header>

  {items.length === 0 ? (
    <p class="text-ink-mute font-serif">まだレビューがありません。</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
      {items.map((e) => (
        <ArticleCard
          href={`/reviews/${e.id}/`}
          slug={e.id}
          title={e.data.title}
          description={e.data.description}
          heroImage={e.data.heroImage}
          pubDate={new Date(e.data.pubDate)}
          category={e.data.category as Category}
          categoryLabel={CATEGORY_LABELS[e.data.category as Category]}
          badge="REVIEW"
          variant="medium"
        />
      ))}
    </div>
  )}
</BaseLayout>
