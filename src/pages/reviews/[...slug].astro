---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import PriceComparison from '../../components/PriceComparison.astro';

export async function getStaticPaths() {
  const items = await getCollection('reviews', ({ data }) => !data.draft);
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<BlogPostLayout
  title={d.title}
  description={d.description}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  heroImage={d.heroImage}
  slug={entry.id}
  category={d.category}
  tags={d.tags}
  collection="reviews"
>
  {d.rating && (
    <p class="font-mono text-base text-ink mb-2 not-prose">
      <span class="text-akane">{'★'.repeat(Math.round(d.rating))}</span><span class="text-rule">{'☆'.repeat(5 - Math.round(d.rating))}</span>
      <span class="text-ink-mute text-sm ml-3">{d.rating.toFixed(1)} / 5</span>
    </p>
  )}

  {(d.pros.length > 0 || d.cons.length > 0) && (
    <div class="grid md:grid-cols-2 gap-x-8 gap-y-4 my-8 text-sm not-prose">
      {d.pros.length > 0 && (
        <div class="border-t-2 border-ink pt-3">
          <p class="eyebrow text-akane mb-2">良かった点</p>
          <ul class="space-y-1.5">
            {d.pros.map((p) => <li class="flex gap-2"><span class="text-akane font-mono shrink-0">+</span><span class="text-ink-soft">{p}</span></li>)}
          </ul>
        </div>
      )}
      {d.cons.length > 0 && (
        <div class="border-t-2 border-ink pt-3">
          <p class="eyebrow text-ink-mute mb-2">気になった点</p>
          <ul class="space-y-1.5">
            {d.cons.map((c) => <li class="flex gap-2"><span class="text-ink-mute font-mono shrink-0">−</span><span class="text-ink-soft">{c}</span></li>)}
          </ul>
        </div>
      )}
    </div>
  )}

  <Content />

  <PriceComparison links={d.affiliateLinks} productName={d.productName} />
</BlogPostLayout>
