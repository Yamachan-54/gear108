---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORY_LABELS, COLLECTION_LABELS } from '../../content.config';
import type { Category, CollectionName } from '../../content.config';
import { CATEGORY_SHORT } from '../../lib/category-theme';

export async function getStaticPaths() {
  const cats = Object.keys(CATEGORY_LABELS) as Category[];
  return cats.map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: Category };
const collectionTypes = Object.keys(COLLECTION_LABELS) as CollectionName[];

type Item = {
  collection: CollectionName;
  slug: string;
  data: any;
};

const buckets = await Promise.all(
  collectionTypes.map((c) =>
    getCollection(c, ({ data }) => !data.draft && data.category === category),
  ),
);
const items: Item[] = buckets
  .flatMap((entries, i) =>
    entries.map((e) => ({
      collection: collectionTypes[i]!,
      slug: e.id,
      data: e.data,
    })),
  )
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));

const label = CATEGORY_LABELS[category];
const short = CATEGORY_SHORT[category];
---
<BaseLayout
  title={`${label} | カテゴリ`}
  description={`${label}に関するレビュー・比較・ニュース・選び方ガイド・セール情報`}
>
  <nav class="text-xs font-mono text-ink-mute mb-6 flex flex-wrap gap-x-2">
    <a href="/" class="hover:text-akane">HOME</a>
    <span>/</span>
    <span class="uppercase">CATEGORY · {short}</span>
  </nav>

  <header class="mb-10 grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-6 pb-6 border-b border-rule">
    <div>
      <p class="eyebrow text-akane">CATEGORY</p>
      <p class="font-mono text-xs text-ink-mute mt-1">{short}</p>
    </div>
    <h1 class="font-serif text-4xl font-bold leading-tight">{label}</h1>
  </header>

  {items.length === 0 ? (
    <p class="text-ink-mute font-serif">このカテゴリにはまだ記事がありません。</p>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
      {items.map((item) => (
        <ArticleCard
          href={`/${item.collection}/${item.slug}/`}
          slug={item.slug}
          title={item.data.title}
          description={item.data.description}
          heroImage={item.data.heroImage}
          pubDate={new Date(item.data.pubDate)}
          category={item.data.category as Category}
          categoryLabel={label}
          badge={COLLECTION_LABELS[item.collection].toUpperCase()}
          variant="medium"
        />
      ))}
    </div>
  )}
</BaseLayout>
