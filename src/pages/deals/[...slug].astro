---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import PriceComparison from '../../components/PriceComparison.astro';

export async function getStaticPaths() {
  const items = await getCollection('deals', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const isExpired = d.saleEndsAt ? d.saleEndsAt.getTime() < Date.now() : false;
---
<BlogPostLayout
  title={d.title}
  description={d.description}
  pubDate={d.pubDate}
  updatedDate={d.updatedDate}
  heroImage={d.heroImage}
  slug={entry.id}
  category={d.category}
  tags={d.tags}
  collection="deals"
>
  <div class="my-4 p-4 rounded-lg border border-orange-700/50 bg-orange-950/20">
    {d.discountPercent && (
      <p class="text-orange-300 font-bold">{d.discountPercent}% OFF</p>
    )}
    {d.saleEndsAt && (
      <p class={`text-sm ${isExpired ? 'text-rose-400' : 'text-zinc-300'}`}>
        セール終了: {d.saleEndsAt.toLocaleString('ja-JP')}
        {isExpired && ' （終了済み）'}
      </p>
    )}
  </div>
  <Content />
  <PriceComparison links={d.affiliateLinks} />
</BlogPostLayout>
