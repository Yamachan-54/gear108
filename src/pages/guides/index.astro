---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORY_LABELS } from '../../content.config';

const items = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate),
);
---
<BaseLayout title="選び方ガイド" description="エンジニア向けガジェットの選び方ガイド">
  <h1 class="text-2xl font-bold mb-6">選び方ガイド</h1>
  {items.length === 0 ? (
    <p class="text-zinc-500">まだ記事がありません。</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((e) => (
        <ProductCard
          href={`/guides/${e.id}/`}
          title={e.data.title}
          description={e.data.description}
          image={e.data.heroImage}
          pubDate={new Date(e.data.pubDate)}
          category={CATEGORY_LABELS[e.data.category]}
          badge="ガイド"
        />
      ))}
    </div>
  )}
</BaseLayout>
